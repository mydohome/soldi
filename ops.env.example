# ops.env — segreti e impostazioni degli strumenti di gestione (ops/).
#
# Copia in ops.env accanto al .env e imposta i permessi:   chmod 600 ops.env
# NON metterlo nel repository e NON aggiungere questi valori al .env: il .env viene
# passato per intero al container web (env_file), ops.env no.
# Formato: NOME=valore (apici facoltativi, nessuna sostituzione di variabili).

# --- Notifiche (bot Telegram dedicato alle allerte di gestione) -------------------
# Distinto dal bot che l'app usa per i backup degli utenti. Vedi docs/OPERATIONS.md.
ALERT_TG_TOKEN=
ALERT_TG_CHAT=

# --- "Interruttore del morto" (opzionale, es. healthchecks.io) ----------------------
# Un cron fermo non può avvisare di essere fermo: questi URL li pingano dall'esterno.
# Meglio un check separato per ciascun job; se manca quello specifico vale HC_PING_URL.
HC_PING_URL=
HC_PING_URL_BACKUP=
HC_PING_URL_OFFSITE=
HC_PING_URL_RESTORE_TEST=
HC_PING_URL_WATCH=

# --- Backup ----------------------------------------------------------------------
# Quanti dump giornalieri tenere in backups/dumps.
DUMP_KEEP=14

# --- Copia fuori macchina cifrata (restic) -------------------------------------------
# Esempi di RESTIC_REPOSITORY:
#   sftp:utente@altro-host:/srv/backup/soldi     (SFTP, es. un altro host raggiungibile in VPN)
#   s3:https://s3.eu-central-003.backblazeb2.com/NOME-BUCKET   (S3 compatibile / Backblaze B2)
RESTIC_REPOSITORY=
# Percorso di un file con la password del repository: permessi 600, FUORI dal repository.
# Conserva la password anche altrove: senza non si recupera nulla.
RESTIC_PASSWORD_FILE=
# Credenziali del backend (solo quelle che servono):
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#B2_ACCOUNT_ID=
#B2_ACCOUNT_KEY=

# --- Soglie del controllo dei backup (valori predefiniti) --------------------------
#BACKUP_MAX_AGE_HOURS=192
#DUMP_MAX_AGE_HOURS=30
#OFFSITE_MAX_AGE_HOURS=30
#DISK_MIN_FREE_PCT=15
#RESTORE_TEST_MAX_AGE_DAYS=40
