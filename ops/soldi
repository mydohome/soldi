#!/usr/bin/env bash
# soldi — punto di ingresso unico per gli strumenti di gestione (ops/).
# Si può richiamare anche con un link simbolico nella cartella di deploy:
#   ln -s app/ops/soldi ./soldi      (poi:  ./soldi help)
# Opzione globale: --home <cartella> (o SOLDI_HOME) se non sei nella cartella di Soldi.
set -euo pipefail
umask 077

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do _d="$(cd "$(dirname "$SELF")" && pwd)"; SELF="$(readlink "$SELF")"; case "$SELF" in /*) ;; *) SELF="$_d/$SELF" ;; esac; done
OPS_DIR="$(cd "$(dirname "$SELF")" && pwd)"
# shellcheck source=ops/lib.sh
. "$OPS_DIR/lib.sh"
# Invocato tramite un link nella cartella di deploy: quella è la cartella di Soldi, anche
# se si lavora da un'altra directory (gli script figli ricevono SOLDI_HOME).
if [ -z "${SOLDI_HOME:-}" ] && [ -n "$OPS_INVOKED_DIR" ] && layout_ok "$OPS_INVOKED_DIR"; then export SOLDI_HOME="$OPS_INVOKED_DIR"; fi

usage() {
  cat <<'TXT'
Uso: soldi [--home <cartella>] <comando> [opzioni]

  status                 quadro d'insieme: container, versione, età dei backup, disco, diagnostica
  setup                  installazione guidata (genera il .env, avvia lo stack)
  diag [--json]          diagnostica del database e della configurazione (sola lettura)
  backup                 backup completo (applicativo + dump + copia fuori macchina)
  restore                ripristino guidato di un backup (--latest | --source <nome> [--yes])
  restore-test           prova di ripristino su un database temporaneo (--from-offsite)
  offsite                copia fuori macchina cifrata con restic (--init per creare il repository)
  check                  controllo dei backup (esce 0 ok, 2 avviso, 1 errore)
  update                 aggiornamento con backup e rollback (--force)
  dr                     ripristino di emergenza su una macchina nuova
  watch                  controllo di salute (di norma da cron; a mano mostra ogni controllo)
  notify-test            prova delle notifiche (--simulate-fault)
  logs [-f] [web|db]     log dei container
  user [list|create|password|telegram|backup|restore|manage] [...]
                         gestione utenti (npm run user:* nel container web)
  cron print|install|remove   pianificazione (watch, backup, controlli, prova di ripristino)

Documentazione: docs/OPERATIONS.md
TXT
}

HOME_OPT=()
if [ "${1:-}" = --home ]; then HOME_OPT=(--home "${2:?--home richiede una cartella}"); shift 2; fi
cmd="${1:-help}"; [ $# -eq 0 ] || shift

run() { local script="$1"; shift; if [ "${#HOME_OPT[@]}" -gt 0 ]; then exec "$OPS_DIR/$script" "${HOME_OPT[@]}" "$@"; else exec "$OPS_DIR/$script" "$@"; fi; }

case "$cmd" in
  help|-h|--help) usage ;;
  status)       run status.sh "$@" ;;
  setup)        run setup.sh "$@" ;;
  cron)         run cron.sh "$@" ;;
  backup)       run backup.sh "$@" ;;
  restore)      run restore.sh "$@" ;;
  restore-test) run restore-test.sh "$@" ;;
  offsite)      run offsite.sh "$@" ;;
  check)        run backup-check.sh "$@" ;;
  update)       run update.sh "$@" ;;
  dr)           run dr.sh "$@" ;;
  watch)        run watch.sh "$@" ;;
  notify-test)  run notify-test.sh "$@" ;;
  diag)
    SOLDI_HOME_ARG=""; if [ "${#HOME_OPT[@]}" -gt 0 ]; then SOLDI_HOME_ARG="${HOME_OPT[1]}"; fi
    detect_layout; choose_compose
    $DC exec -T web test -f scripts/diag.js >/dev/null 2>&1 || die "La diagnostica non è nell'immagine in esecuzione: serve la ricostruzione (soldi update)."
    # shellcheck disable=SC2086
    exec $DC exec -T web npm run diag --silent -- "$@" ;;
  user)
    SOLDI_HOME_ARG=""; if [ "${#HOME_OPT[@]}" -gt 0 ]; then SOLDI_HOME_ARG="${HOME_OPT[1]}"; fi
    detect_layout; choose_compose
    sub="${1:-manage}"; [ $# -eq 0 ] || shift
    case "$sub" in list|create|password|telegram|backup|restore) script="user:$sub" ;; manage) script="user:manage" ;; *) die "soldi user: sottocomando sconosciuto: $sub (list, create, password, telegram, backup, restore, manage)" ;; esac
    # terminale solo se c'è (i comandi interattivi lo richiedono)
    tty_flag=(-T); if [ -t 0 ] && [ -t 1 ]; then tty_flag=(); fi
    # shellcheck disable=SC2086
    if [ $# -gt 0 ]; then exec $DC exec ${tty_flag[@]+"${tty_flag[@]}"} web npm run "$script" -- "$@"; else exec $DC exec ${tty_flag[@]+"${tty_flag[@]}"} web npm run "$script"; fi ;;
  logs)
    SOLDI_HOME_ARG=""; if [ "${#HOME_OPT[@]}" -gt 0 ]; then SOLDI_HOME_ARG="${HOME_OPT[1]}"; fi
    detect_layout; choose_compose
    follow=(); svc=()
    for a in "$@"; do case "$a" in -f) follow=(-f) ;; web|db) svc=("$a") ;; *) die "logs: argomento sconosciuto: $a" ;; esac; done
    # shellcheck disable=SC2086
    exec $DC logs --tail=200 ${follow[@]+"${follow[@]}"} ${svc[@]+"${svc[@]}"} ;;
  *) printf 'soldi: comando sconosciuto: %s\n\n' "$cmd" >&2; usage >&2; exit 1 ;;
esac
