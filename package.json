{
  "name": "soldi",
  "version": "1.0.0",
  "description": "Soldi — personal expense & income tracker (Node.js + PostgreSQL)",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
