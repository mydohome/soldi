# Copy this file to .env and adjust the values.

# --- Web app ---
# Port published on the host (Debian server etc.). The app inside the container
# always listens on 3000; only this host-side port changes.
HOST_PORT=3000
# Secret used to sign session cookies. MUST be long and random in production.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Set to true ONLY if the app is reached over HTTPS (directly or behind an
# HTTPS reverse proxy). Enables HSTS, upgrade-insecure-requests and Secure
# cookies. Leave false for a plain-HTTP deployment (http://server:3010),
# otherwise the browser upgrades the app's own assets to https:// and the
# page hangs on the loading screen.
HTTPS_ENABLED=false
TZ=Europe/Rome
# Registrazione di nuovi utenti dalla schermata di login.
# false = disabilitata (la registrazione resta comunque possibile finché non
# esiste alcun utente, per creare il primo account su un'installazione nuova).
ALLOW_REGISTRATION=true

# --- Database (PostgreSQL) ---
PGUSER=soldi
PGPASSWORD=soldi
PGDATABASE=soldi

# --- Automatic backups ---
BACKUP_ENABLED=true
# Cron expression (server time / TZ above). Default: every Sunday at 03:00.
BACKUP_CRON=0 3 * * 0
# How many backups to keep before pruning the oldest.
BACKUP_KEEP=8

# --- Aggiornamento dall'app ---
# true = il pulsante "Aggiorna" in Impostazioni fa `git pull` + riavvio del
# container (senza ricostruire l'immagine). Richiede i mount in docker-compose.yml
# (già presenti). Le modifiche al Dockerfile richiedono comunque ./scripts/update.sh.
SELF_UPDATE_ENABLED=false

# --- Spese fisse (movimenti ricorrenti) ---
RECURRING_ENABLED=true
# Quando controllare le spese fisse dovute. Default: ogni giorno alle 06:05.
# In più c'è sempre un controllo all'avvio (recupero dopo downtime).
RECURRING_CRON=5 6 * * *
