# Copy this file to .env and adjust the values.

# --- Web app ---
PORT=3000
# Secret used to sign session cookies. MUST be long and random in production.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Set to true only when serving over HTTPS (cookies become Secure-only).
COOKIE_SECURE=false
TZ=Europe/Rome

# --- Database (PostgreSQL) ---
PGUSER=soldi
PGPASSWORD=soldi
PGDATABASE=soldi

# --- Automatic backups ---
BACKUP_ENABLED=true
# Cron expression (server time / TZ above). Default: every Sunday at 03:00.
BACKUP_CRON=0 3 * * 0
# How many backups to keep before pruning the oldest.
BACKUP_KEEP=8
